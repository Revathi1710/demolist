<script>
// Modern JavaScript Functions

function increaseQuantity(button) {
    const input = button.parentElement.querySelector('.quantity-input');
    input.value = parseInt(input.value) + 1;
    calculateTotal(input);
}

function decreaseQuantity(button) {
    const input = button.parentElement.querySelector('.quantity-input');
    if (parseInt(input.value) > 0) {
        input.value = parseInt(input.value) - 1;
        calculateTotal(input);
    }
}

function addToCart(button) {
    const card = button.closest('.product-card');
    const input = card.querySelector('.quantity-input');
    const currentValue = parseInt(input.value);
    input.value = currentValue + 1;
    calculateTotal(input);
    
    // Add visual feedback
    button.style.background = 'linear-gradient(135deg, #ff6b6b, #ee5a52)';
    button.textContent = 'Added!';
    setTimeout(() => {
        button.style.background = 'linear-gradient(135deg, #4caf50, #45a049)';
        button.textContent = '+ Add';
    }, 1000);
}

function calculateTotal(input) {
    const card = input.closest('.product-card');
    const originalPrice = parseFloat(input.dataset.originalPrice);
    const sellingPrice = parseFloat(input.dataset.sellingPrice);
    const quantity = parseInt(input.value);
    const totalPriceElement = card.querySelector('.product-total');
    const totalPriceContainer = card.querySelector('.total-price');

    if (quantity > 0) {
        const total = sellingPrice * quantity;
        totalPriceElement.textContent = total.toFixed(2);
        totalPriceContainer.style.display = 'block';
    } else {
        totalPriceContainer.style.display = 'none';
    }

    updateProductDetails();
}

function updateProductDetails() {
    const productInputs = document.querySelectorAll(".quantity-input");
    const noProductInput = document.querySelector(".noProduct");
    const savePriceInput = document.querySelector(".saveprice");
    const overallInput = document.querySelector(".overall");
    const totalPriceInput = document.querySelector("#totalpriceinput");

    let totalProducts = 0;
    let totalPrice = 0;
    let totalOriginalPrice = 0;

    productInputs.forEach((input) => {
        const quantity = parseInt(input.value);
        const originalPrice = parseFloat(input.dataset.originalPrice);
        const sellingPrice = parseFloat(input.dataset.sellingPrice);

        if (quantity > 0) {
            totalProducts += quantity;
            totalPrice += sellingPrice * quantity;
            totalOriginalPrice += originalPrice * quantity;
        }
    });

    const savePrice = totalOriginalPrice - totalPrice;

    noProductInput.value = totalProducts;
    overallInput.value = totalPrice.toFixed(2);
    savePriceInput.value = savePrice.toFixed(2);
    totalPriceInput.value = totalPrice.toFixed(2);

    const totalPriceElement = document.getElementById("totalPrice");
    totalPriceElement.textContent = totalPrice.toFixed(2);
    
    // Add animation for price changes
    totalPriceElement.classList.add('price-animated');
    setTimeout(() => {
        totalPriceElement.classList.remove('price-animated');
    }, 500);
}

function openImageModal(imageElement) {
    var modal = document.getElementById("imageModal");
    var modalImage = document.getElementById("modalImage");
    modal.style.display = "block";
    modalImage.src = imageElement.src;
}

function closeImageModal() {
    var modal = document.getElementById("imageModal");
    modal.style.display = "none";
}

function openYoutubeModal(url) {
    const videoId = extractYoutubeID(url);
    const embedUrl = `https://www.youtube.com/embed/${videoId}?rel=0&autoplay=1`;
    document.getElementById('youtubeFrame').src = embedUrl;
    document.getElementById('youtubeModal').style.display = 'block';
}

function closeYoutubeModal() {
    document.getElementById('youtubeModal').style.display = 'none';
    document.getElementById('youtubeFrame').src = '';
}

function extractYoutubeID(url) {
    const regex = /(?:youtube\.com\/(?:[^\/]+\/.+|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/)([^"&?/\s]{11})/i;
    const match = url.match(regex);
    return match ? match[1] : null;
}

// Form submission
document.getElementById("submitButton").addEventListener("click", function () {
    const totalPriceInput = document.querySelector("#totalpriceinput");
    const totalPrice = parseFloat(totalPriceInput.value);

    if (totalPrice >= 2000) {
        const name = document.getElementById("name").value;
        const email = document.getElementById("email").value;
        const number = document.getElementById("number").value;
        const address = document.getElementById("address").value;
        const pincode = document.getElementById("pincode").value;
        
        if (name === "" || number === "" || address === "" || pincode === "") {
            alert("Please fill out all required fields.");
        } else if (!isProductSelected()) {
            alert("Please select at least one product.");
        } else {
            sendEmailAndWhatsApp();
        }
    } else {
        alert("Total price must be at least ₹2000 to submit the form.");
    }
});

function isProductSelected() {
    const productQuantities = document.querySelectorAll(".quantity-input");
    for (const quantityInput of productQuantities) {
        if (parseInt(quantityInput.value) > 0) {
            return true;
        }
    }
    return false;
}

function sendEmailAndWhatsApp() {
    const phoneNumber = "+919092284002";
    const name = document.getElementById("name").value;
    const email = document.getElementById("email").value;
    const number = document.getElementById("number").value;
    const address = document.getElementById("address").value;
    const pincode = document.getElementById("pincode").value;
    const totalpriceinput = document.getElementById("totalpriceinput").value;
         
    let message = "Hello, I'm interested in the following products:\n";
    const productCards = document.querySelectorAll(".product-card");
    
    productCards.forEach((card) => {
        const productName = card.querySelector(".product-name").textContent;
        const sellingPrice = parseFloat(card.querySelector(".quantity-input").dataset.sellingPrice);
        const quantity = parseInt(card.querySelector(".quantity-input").value);
        
        if (quantity > 0) {
            message += `${productName}: ${quantity} pieces = ₹${(sellingPrice * quantity).toFixed(2)}\n`;
        }
    });

    message += `\nTotal Price: ₹${totalpriceinput}\nName: ${name}\nEmail: ${email}\nMobile Number: ${number}\nAddress: ${address}\nPincode: ${pincode}`;

    const encodedMessage = encodeURIComponent(message);
    const whatsappLink = `https://wa.me/${phoneNumber}?text=${encodedMessage}`;

    window.location.href = whatsappLink;
}

// Initialize carousel
$(document).ready(function() {
    $('.carousel-item').eq(0).addClass('active');
    var currentSlide = 0;

    function changeSlide() {
        var prevSlide = currentSlide;
        currentSlide = (currentSlide + 1) % $('.carousel-item').length;
        $('.carousel-item').eq(prevSlide).removeClass('active');
        $('.carousel-item').eq(currentSlide).addClass('active');
        setTimeout(changeSlide, 5000);
    }

    if ($('.carousel-item').length > 1) {
        changeSlide();
    }
});

// Close modals when clicking outside
window.onclick = function(event) {
    const imageModal = document.getElementById("imageModal");
    const youtubeModal = document.getElementById("youtubeModal");
    
    if (event.target == imageModal) {
        closeImageModal();
    }
    if (event.target == youtubeModal) {
        closeYoutubeModal();
    }
}

