    <script>
        let cart = [];

        function increaseQuantity(button) {
            const input = button.parentElement.querySelector('.quantity-input');
            input.value = parseInt(input.value) + 1;
            updateCart();
        }

        function decreaseQuantity(button) {
            const input = button.parentElement.querySelector('.quantity-input');
            if (parseInt(input.value) > 0) {
                input.value = parseInt(input.value) - 1;
                updateCart();
            }
        }

        function quickAdd(button) {
            const row = button.closest('.product-row');
            const input = row.querySelector('.quantity-input');
            input.value = parseInt(input.value) + 1;
            updateCart();
            
            // Visual feedback
            button.style.background = 'linear-gradient(135deg, #ff6b6b, #ee5a52)';
            button.textContent = 'Added!';
            setTimeout(() => {
                button.style.background = 'linear-gradient(135deg, #4caf50, #45a049)';
                button.textContent = '+ Add';
            }, 1000);
        }

        function updateCart() {
            cart = [];
            let totalItems = 0;
            let originalTotal = 0;
            let finalTotal = 0;

            // Collect all products with quantity > 0
            document.querySelectorAll('.quantity-input').forEach(input => {
                const quantity = parseInt(input.value);
                if (quantity > 0) {
                    const productData = {
                        id: input.dataset.productId,
                        name: input.dataset.productName,
                        image: input.dataset.productImage,
                        originalPrice: parseFloat(input.dataset.originalPrice),
                        sellingPrice: parseFloat(input.dataset.sellingPrice),
                        quantity: quantity
                    };
                    
                    cart.push(productData);
                    totalItems += quantity;
                    originalTotal += productData.originalPrice * quantity;
                    finalTotal += productData.sellingPrice * quantity;
                }
            });

            const savings = originalTotal - finalTotal;

            // Update header stats
            document.getElementById('total-products').textContent = totalItems;
            document.getElementById('total-savings').textContent = '₹' + savings.toFixed(2);
            document.getElementById('cart-total').textContent = '₹' + finalTotal.toFixed(2);

            // Update cart summary
            document.getElementById('cart-items-count').textContent = totalItems;
            document.getElementById('original-total').textContent = '₹' + originalTotal.toFixed(2);
            document.getElementById('savings-amount').textContent = '₹' + savings.toFixed(2);
            document.getElementById('final-total').textContent = '₹' + finalTotal.toFixed(2);

            // Update cart items display
            updateCartDisplay();

            // Enable/disable proceed button
            const proceedBtn = document.getElementById('proceed-btn');
            if (finalTotal >= 2000) {
                proceedBtn.disabled = false;
                proceedBtn.textContent = 'Proceed to Checkout';
            } else if (totalItems > 0) {
                proceedBtn.disabled = true;
                proceedBtn.textContent = `Min Order ₹2000 (₹${(2000 - finalTotal).toFixed(2)} more)`;
            } else {
                proceedBtn.disabled = true;
                proceedBtn.textContent = 'Proceed to Checkout';
            }
        }

        function updateCartDisplay() {
            const cartContainer = document.getElementById('cart-items');
            
            if (cart.length === 0) {
                cartContainer.innerHTML = `
                    <div class="cart-empty">
                        <i class="fas fa-shopping-cart"></i>
                        <div>Your cart is empty</div>
                        <small>Add products from the left to get started</small>
                    </div>
                `;
                return;
            }

            cartContainer.innerHTML = cart.map(item => `
                <div class="cart-item">
                    <img src="${item.image}" alt="${item.name}" class="cart-item-image">
                    <div class="cart-item-details">
                        <div class="cart-item-name">${item.name}</div>
                        <div class="cart-item-price">₹${item.sellingPrice} × ${item.quantity} = ₹${(item.sellingPrice * item.quantity).toFixed(2)}</div>
                    </div>
                    <div class="cart-item-quantity">${item.quantity}</div>
                </div>
            `).join('');
        }

        function openCheckoutForm() {
            document.getElementById('total-amount-input').value = '₹' + document.getElementById('final-total').textContent.replace('₹', '');
            document.getElementById('checkoutModal').style.display = 'block';
        }

        function closeCheckoutForm() {
            document.getElementById('checkoutModal').style.display = 'none';
        }

        function submitOrder() {
            const name = document.getElementById('name').value;
            const email = document.getElementById('email').value;
            const number = document.getElementById('number').value;
            const address = document.getElementById('address').value;
            const pincode = document.getElementById('pincode').value;

            if (!name || !number || !address || !pincode) {
                alert('Please fill in all required fields');
                return;
            }

            // Prepare WhatsApp message
            const phoneNumber = "+919092284002";
            let message = "🎆 New Order from Modern Crackers!\n\n";
            
            message += "📋 ORDER DETAILS:\n";
            cart.forEach(item => {
                message += `• ${item.name}: ${item.quantity} pcs = ₹${(item.sellingPrice * item.quantity).toFixed(2)}\n`;
            });
            
            const finalTotal = parseFloat(document.getElementById('final-total').textContent.replace('₹', ''));
            const originalTotal = parseFloat(document.getElementById('original-total').textContent.replace('₹', ''));
            const savings = originalTotal - finalTotal;
            
            message += `\n💰 PAYMENT SUMMARY:\n`;
            message += `Original Total: ₹${originalTotal.toFixed(2)}\n`;
            message += `You Save: ₹${savings.toFixed(2)}\n`;
            message += `Final Total: ₹${finalTotal.toFixed(2)}\n\n`;
            
            message += `👤 CUSTOMER DETAILS:\n`;
            message += `Name: ${name}\n`;
            message += `Email: ${email}\n`;
            message += `Mobile: ${number}\n`;
            message += `Address: ${address}\n`;
            message += `Pincode: ${pincode}\n`;

            const encodedMessage = encodeURIComponent(message);
            const whatsappLink = `https://wa.me/${phoneNumber}?text=${encodedMessage}`;

            // Open WhatsApp
            window.open(whatsappLink, '_blank');
            
            // Close form and reset cart
            closeCheckoutForm();
            alert('Order submitted! You will be redirected to WhatsApp.');
        }

        // Modal functions
        function openImageModal(img) {
            document.getElementById('modalImage').src = img.src;
            document.getElementById('imageModal').style.display = 'block';
        }

        function closeImageModal() {
            document.getElementById('imageModal').style.display = 'none';
        }

        function openYoutubeModal(url) {
            const videoId = extractYoutubeID(url);
            const embedUrl = `https://www.youtube.com/embed/${videoId}?rel=0&autoplay=1`;
            document.getElementById('youtubeFrame').src = embedUrl;
            document.getElementById('youtubeModal').style.display = 'block';
        }

        function closeYoutubeModal() {
            document.getElementById('youtubeModal').style.display = 'none';
            document.getElementById('youtubeFrame').src = '';
        }

        function extractYoutubeID(url) {
            const regex = /(?:youtube\.com\/(?:[^\/]+\/.+|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/)([^"&?/\s]{11})/i;
            const match = url.match(regex);
            return match ? match[1] : null;
        }

        // Close modals when clicking outside
        window.onclick = function(event) {
            const imageModal = document.getElementById('imageModal');
            const youtubeModal = document.getElementById('youtubeModal');
            const checkoutModal = document.getElementById('checkoutModal');
            
            if (event.target == imageModal) {
                closeImageModal();
            }
            if (event.target == youtubeModal) {
                closeYoutubeModal();
            }
            if (event.target == checkoutModal) {
                closeCheckoutForm();
            }
        }

        // Initialize cart on page load
        updateCart();
    </script>

    <?php include('footer.php'); ?>
</body>
</html>